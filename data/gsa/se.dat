[Chatnoir]
desc=An experimental engine by researchers that uses the Common Crawl index. The engine is open source.
enabled=1
country=International
url=https://www.chatnoir.eu/api/v1/_search
post data={"query":"%search%","index":[],"from":%page%,"size":10,"_extended_meta":true}
description=An experimental engine by researchers that uses the Common Crawl index. The engine is open source.
referrer=https://www.chatnoir.eu/
download referrer=1
start page=0
inc page=10
remove first page parameter=0
add header=Accept: application/json, text/plain, */*|Authorization: Bearer %token%|Content-Type: application/json|Sec-CH-UA-Arch: "x86"|Sec-CH-UA-Bitness: "64"|Sec-CH-UA-Full-Version: "138.0.7204.169"|Sec-CH-UA-Full-Version-List: "Not)A;Brand";v="8.0.0.0", "Chromium";v="138.0.7204.169", "Google Chrome";v="138.0.7204.169"|Sec-CH-AU-Mobile: ?0|Sec-CH-AU-Model: ""|Sec-CH-AU-Platform: "Windows"|Sec-CH-AU-Platform-Version: "19.0.0"|Sec-Fetch-Dest: empty|Sec-Fetch-Mode: cors|Sec-Fetch-Site: same-origin|Sec-Gpc: 1|X-Requested-With: XMLHttpRequest|X-CSRF-Token: %cookie-csrftoken%
user agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36
wait between search=5
banned=<h2 class="h2" id="challenge-running">|<span id="challenge-error-text">
accept="indices":
token_url=https://www.chatnoir.eu/?init
token_post data=init
token_add header=X-CSRF-Token: %cookie-csrftoken%|Sec-Fetch-Dest: empty|Sec-Fetch-Mode: cors|Sec-Fetch-Site: same-origin|Sec-Gpc: 1|X-Requested-With: XMLHttpRequest
token_referrer=https://www.chatnoir.eu/
token_front="token":
token_front2="token":
token_front3="
token_back="
cut top="uuid":
seperator="uuid":
url_front="target_uri":
url_front2="
url_back="
title_front="title":
title_front2="
title_back="
ignore mask=chatnoir.eu

;**************************************************************************

